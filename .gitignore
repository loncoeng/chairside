node_modules/
dist/
.wrangler/
.dev.vars

# Which Cloudflare account this directory deploys to. wrangler has one login
# for the whole machine and the directory tells it nothing, so without this a
# deploy run here goes wherever that login points — which is somebody else's
# account. Holds an identifier, not a credential, and is not committed anyway.
.env
*.log
*.sqlite
*.sqlite3
.DS_Store
publish-guard.generated.toml
publish-guard.local.toml

# Generated from wrangler.toml by `wrangler types`, and regenerated by
# `npm run check`. Committed, it goes stale the moment a binding is added and
# nothing says so — and every wrangler update is a 16,000-line diff.
worker-configuration.d.ts

# Built by scripts/build-demo-db.ts during `npm run build`, from the same seed
# files the live instance uses. Committing it would be a second copy of the
# sample to keep in step — and 640KB of binary in every diff.
public/demo.sqlite.gz
public/sql-wasm.wasm
