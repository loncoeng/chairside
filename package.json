{
  "name": "chairside",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "check": "npm run types && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "deploy": "npm run build && wrangler deploy",
    "seed": "wrangler d1 execute chairside --remote --file seed/demo.sql",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "preact": "^10.25.0"
  }
}
