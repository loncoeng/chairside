# Sent with every static file. The Worker sets its own on API replies.
#
# A customer list needs these more than most pages do: the whole point of a
# tight content policy is that an injected script cannot send the names
# somewhere. Nothing here loads from anywhere else, so the policy can be as
# narrow as it looks.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# The page itself, left exactly as built. Without no-transform, Cloudflare adds
# its analytics script to the HTML, which the policy above then blocks, and
# which would send page views off the site from a demo that says it does not.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
